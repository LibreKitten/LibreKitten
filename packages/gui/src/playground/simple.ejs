<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" href="<%= htmlWebpackPlugin.options.root %>images/librekitten-colour.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="<%= htmlWebpackPlugin.options.root %>images/apple-touch-icon.png">
    <% if (htmlWebpackPlugin.options.description) { %>
      <meta name="description" content="<%= htmlWebpackPlugin.options.description %>" />
    <% } %>
    <title><%= htmlWebpackPlugin.options.title %></title>
    <style>
      body[data-splash-theme="dark"] {
        background: #111;
      }

      noscript {
        font-family: "Inter Variable", "Helvetica Neue", Helvetica, sans-serif;
      }
    </style>
  </head>
  <body>
    <noscript>
      <h1>This page requires JavaScript</h1>
    </noscript>

    <script>
      (function() {
        var theme = '';

        try {
          var themeSetting = localStorage.getItem('tw:theme');
        } catch (e) {
          // ignore
        }
        if (themeSetting === 'light') {
          theme = 'light';
        } else if (themeSetting === 'dark') {
          theme = 'dark';
        } else if (themeSetting === 'light-modern') {
          theme = 'light-modern';
        } else if (themeSetting) {
          try {
            var parsed = JSON.parse(themeSetting);
            if (parsed.gui === 'dark' || parsed.gui === 'light' || parsed.gui === 'light-modern') {
              theme = parsed.gui;
            }
          } catch (e) {
            // ignore
          }
        }

        if (!theme) {
          theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }

        document.body.setAttribute('data-splash-theme', theme);
      })();
    </script>

    <div id="app"></div>
  </body>
</html>
